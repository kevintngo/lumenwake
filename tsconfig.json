{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "lumen-dom",
    "types": [
      "vite/client"
    ],
    "paths": {
      "lumen-dom": [
        "./src/ui/dom/index.ts"
      ],
      "lumen-dom/jsx-runtime": [
        "./src/ui/dom/jsx-runtime.ts"
      ],
      "lumen-dom/jsx-dev-runtime": [
        "./src/ui/dom/jsx-runtime.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
